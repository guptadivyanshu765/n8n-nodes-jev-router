{
  "name": "n8n-nodes-jev-router",
  "version": "0.1.0",
  "description": "n8n community node for TypeSafe AI's Jev \"System One\" decision model — classify, score, and route workflow items using typed structured decisions instead of free-text chat.",
  "keywords": [
    "n8n-community-node-package",
    "jev",
    "typesafe-ai",
    "classification",
    "routing"
  ],
  "license": "MIT",
  "homepage": "https://github.com/guptadivyanshu765/n8n-nodes-jev-router",
  "author": {
    "name": "Divyanshu Gupta",
    "email": "guptadivyanshu765@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guptadivyanshu765/n8n-nodes-jev-router.git"
  },
  "bugs": {
    "url": "https://github.com/guptadivyanshu765/n8n-nodes-jev-router/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/JevApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JevRouter/JevRouter.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.49.1",
    "eslint": "^9.29.0",
    "prettier": "^3.8.3",
    "release-it": "^20.2.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
