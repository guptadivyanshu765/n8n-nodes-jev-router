{
  "name": "n8n-nodes-jev-router",
  "version": "0.1.0",
  "description": "n8n community node for TypeSafe AI's Jev \"System One\" decision model — classify, score, and route workflow items using typed structured decisions instead of free-text chat.",
  "keywords": [
    "n8n-community-node-package",
    "jev",
    "typesafe-ai",
    "classification",
    "routing"
  ],
  "license": "MIT",
  "homepage": "https://github.com/your-org/n8n-nodes-jev-router",
  "author": {
    "name": "Divyanshu Gupta",
    "email": "guptadivyanshu765@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/n8n-nodes-jev-router.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json --ext .ts,.json",
    "lintfix": "eslint nodes credentials package.json --ext .ts,.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/JevApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JevRouter/JevRouter.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "jsonc-eslint-parser": "^2.4.0",
    "n8n-core": "^1.14.1",
    "n8n-workflow": "^1.14.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
